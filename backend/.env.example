# Copy this file to ".env" in the same folder and fill in your own values.
# Never commit the real .env file.

# Neon Postgres connection string. Get this from your Neon project
# dashboard -> Connection Details -> "Connection string" (pick the
# "Pooled connection" one). It looks like:
# postgresql+psycopg2://USER:PASSWORD@ep-xxxx.neon.tech/DBNAME?sslmode=require
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@YOUR-NEON-HOST/DBNAME?sslmode=require

# Path to the checkpoint file, relative to backend/
CHECKPOINT_PATH=checkpoints/best_model.pt

# Origin the frontend runs on (Vite's default dev port)
FRONTEND_ORIGIN=http://localhost:5173

# cpu is correct for this model size — you don't need a GPU
DEVICE=cpu
